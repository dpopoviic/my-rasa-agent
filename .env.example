RASA_LICENSE=""

# ---------------------------------------------------------------------
# AZURE (kljuc dolazi IZ AZURE-a, ne generises ga sam)
# Azure AI Foundry portal -> tvoj projekat/resurs (dp-20220322-foundry) -> Keys and Endpoint -> KEY 1.
# Koristi se u endpoints.yml preko ${AZURE_API_KEY} (LLM i embeddings).
# ---------------------------------------------------------------------
AZURE_API_KEY=""

# ---------------------------------------------------------------------
# Tajne koje SI SAM GENERISAO (nisu vezane ni za koji servis)
# ---------------------------------------------------------------------
# AUTH_TOKEN se vise ne koristi: Rasa radi bez HTTP API-ja (bez --enable-api), a
# "nova konverzacija" ide kroz secure_rest kanal (POST /webhooks/secure_rest/restart).
# Ne dodavati ga - Rasa ga sama cita kao podrazumevani --auth-token.

# Rasa akcije -> .NET app (header X-Internal-Api-Key).
# ISTA vrednost mora biti u .NET appsettings.json: InternalApi:ApiKey
INTERNAL_API_KEY=""

# Javni EC (P-256) kljuc kojim secure_rest kanal proverava token korisnika.
# Par je privatnom kljucu u .NET appsettings.json: UserToken:PrivateKeyPem.
# Nije tajna (moze u git), ali mora biti par tacno tom privatnom kljucu.
USER_TOKEN_PUBLIC_KEY_PATH="keys/user_token_public.pem"

# Rasa agent -> MCP server sa alatima (header X-Mcp-Api-Key). Generisi sam,
# npr: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_API_KEY=""
# Port MCP servera (mcp_tools/server.py, slusa samo na 127.0.0.1)
MCP_SERVER_PORT="8765"

# Adresa .NET aplikacije (iz Properties/launchSettings.json: https 60120 / http 60121)
INTERNAL_API_BASE_URL="https://localhost:60120"
# Lokalni ASP.NET dev sertifikat Python ne priznaje -> u razvoju false. U produkciji obavezno true.
INTERNAL_API_VERIFY_SSL="false"

# Azure AI Search (baza znanja)
AZURE_SEARCH_ENDPOINT="https://az-search-service-mss-stud-proj.search.windows.net"
AZURE_SEARCH_INDEX="rag-1790004221586-mss-stud-proj"
# SAMO Query key (citanje). Admin key ovde ne ide: Rasa ga ne koristi, a njime se
# indeks moze menjati i brisati (princip najmanjih prava).
AZURE_SEARCH_API_KEY=""

# ---------------------------------------------------------------------
# Privatnost (podaci roditelja i ucenika)
# ---------------------------------------------------------------------
# Bez anonimne telemetrije o koriscenju ka Rasi.
RASA_TELEMETRY_ENABLED="false"
# Produkcija: WARNING. DEBUG belezi tekst poruka - samo privremeno, lokalno.
LOG_LEVEL="WARNING"
